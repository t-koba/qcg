# Fail closed: dependency install scripts never execute automatically.
# Install-time script execution is a supply-chain exfiltration vector; neither
# locked script (esbuild, fsevents) is needed - the esbuild binary ships via
# optionalDependencies. Explicit `npm run ...` project scripts still run.
# Committed policy so a forgotten --ignore-scripts flag cannot re-enable them.
ignore-scripts=true
