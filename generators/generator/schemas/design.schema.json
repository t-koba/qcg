{
  "type": "object",
  "additionalProperties": false,
  "required": ["package"],
  "properties": {
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "sources"],
      "properties": {
        "manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["generator"],
          "description": "Full target manifest as structured data. Only permissions and secrets are supplied by the operator authority answer; omitted manifest fields use the core defaults.",
          "properties": {
            "generator": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "version", "qcg_version"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "description": "Non-blank generator identifier; the core trims it before validation." },
                "name": { "type": "string" },
                "version": { "type": "string" },
                "qcg_version": { "type": "string" },
                "description": { "type": "string" },
                "authors": { "type": "array", "items": { "type": "string" } }
              }
            },
            "llm": { "type": "object" },
            "inputs": { "type": "object" },
            "resources": { "type": "object" },
            "tools": { "type": "object" },
            "runtime": { "type": "object" },
            "budget": { "type": "object" },
            "flow": { "type": "array" },
            "parallel": { "type": "array" },
            "blocks": { "type": "object" },
            "outputs": { "type": "object" },
            "failure": { "type": "object" },
            "journal": { "type": "object" },
            "assets": { "type": "object" }
          }
        },
        "sources": {
          "type": "object",
          "maxProperties": 4096,
          "description": "At most 4096 source entries are accepted; the authoring runtime also bounds decoded bytes.",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^/\\\\\\u0000]+(?:/[^/\\\\\\u0000]+)*$",
            "allOf": [
              { "not": { "pattern": "^[A-Za-z]:" } },
              { "not": { "pattern": "(^|/)\\.(?:/|$)" } },
              { "not": { "pattern": "(^|/)\\.\\.(?:/|$)" } }
            ],
            "not": { "pattern": "^qcg\\.toml$" }
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["encoding", "content"],
                "properties": {
                  "encoding": { "const": "utf8" },
                  "content": { "type": "string" },
                  "unix_mode": {
                    "type": "string",
                    "pattern": "^0[6-7][0-7][0-7]$",
                    "description": "Optional Unix file mode in canonical octal notation, from 0600 through 0777; special bits are not allowed."
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["encoding", "content"],
                "properties": {
                  "encoding": { "const": "base64" },
                  "content": {
                    "type": "string",
                    "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
                    "description": "Canonical RFC 4648 base64 without whitespace."
                  },
                  "unix_mode": {
                    "type": "string",
                    "pattern": "^0[6-7][0-7][0-7]$",
                    "description": "Optional Unix file mode in canonical octal notation, from 0600 through 0777; special bits are not allowed."
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
